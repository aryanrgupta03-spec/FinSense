# FinSense Environment Configuration Template
# Copy this file to .env and adjust as necessary

# Database Configuration
# Local SQLite default: sqlite:///./finsense.db
# Docker Compose Postgres: postgresql://finsense:finsense_secure_pass_2026@postgres:5432/finsensedb
DATABASE_URL=sqlite:///./finsense.db

# Authentication Security
JWT_SECRET=finsense-production-secret-key-super-secure-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Language Model / Copilot Integration (Optional)
# Point to local Ollama (e.g. http://localhost:11434/v1) or any OpenAI-compatible server
SLM_ENABLED=true
SLM_API_BASE=http://localhost:11434/v1
SLM_API_KEY=
SLM_MODEL_NAME=llama3.2:1b

# Application Currency Defaults
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
